# ── Local development environment variables ──────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.
#
#   cp .env.example .env
#
# Only EIA_API_KEY is required to run the full local stack.
# All other values below match the docker-compose.yml defaults and can be left
# as-is for local development.
# ─────────────────────────────────────────────────────────────────────────────

# EIA Open Data API key
# Free registration at: https://www.eia.gov/opendata/
# Required to seed the local database with real gas price data (backfill.py).
EIA_API_KEY=your_eia_api_key_here

# ── Postgres (matches docker-compose defaults — change only if you have a conflict) ──
POSTGRES_DB=gas_prices
POSTGRES_USER=gas_price_admin
POSTGRES_PASSWORD=localpassword

# ── AWS credentials (only needed if running Terraform or deploying to AWS) ───
# These are NOT used by docker compose — they are for `aws` CLI / `terraform`.
# Configure via `aws configure` or set here for CI.
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_DEFAULT_REGION=us-east-1
